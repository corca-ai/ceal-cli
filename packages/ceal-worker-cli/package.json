{
	"name": "@corca-ai/ceal-worker-cli",
	"version": "0.77.0",
	"private": true,
	"license": "MIT",
	"description": "Credential-separated worker-facing Ceal CLI",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./session-store": {
			"types": "./dist/profile-store.d.ts",
			"import": "./dist/profile-store.js"
		}
	},
	"bin": {
		"ceal": "./dist/bin.js"
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "node ../../test/run-source-tests.ts test/*.test.ts",
		"prepack": "npm run clean && npm run build",
		"coverage": "c8 node ../../test/run-source-tests.ts test/*.test.ts"
	},
	"dependencies": {
		"@corca-ai/ceal": "0.77.0",
		"@corca-ai/ceal-protocol": "0.73.0",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@types/node": "24.6.0",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
