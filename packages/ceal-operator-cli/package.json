{
	"name": "@corca-ai/ceal-operator-cli",
	"version": "0.65.0",
	"private": true,
	"license": "MIT",
	"description": "Public Ceal operator CLI surface",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"bin": {
		"cealctl": "./dist/bin.js"
	},
	"files": ["dist", "LICENSE"],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "npm run clean && tsc -p tsconfig.build.json",
		"test": "npm run build && node --test test/*.test.mjs",
		"prepack": "npm run build"
	},
	"dependencies": {
		"@corca-ai/ceal-protocol": "0.66.1",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@types/node": "24.6.0",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
