#!/bin/sh
# Pre-push gate. `check.yml` now runs the full gate on every push to main and
# every pull request, but a push to any other branch still carries no automated
# verification of its own, so this hook is the last cheap point for that case —
# and it is the only one that runs before the push rather than after. A tag push
# is the expensive one — a failed release tag cannot be reused — so tags run the
# full gate, not the fast one.
#
# AGENTS.md says to time a gate on the host in hand rather than quote a figure
# from a document, because the recorded numbers went stale unnoticed once
# already. This hook is the one place the gate runs on a real host on a schedule,
# so it records what it measured: the phase label and its elapsed seconds go to
# stderr for the human, and a `command_timing.v1` line goes to
# `.charness/quality/command-timing.jsonl` so a later session can read the trend
# instead of trusting a number someone typed into a doc.
#
# The log is evidence, not a gate, and that has to hold under failure too: every
# step of `record_timing` ends in `|| return 0`, because a full disk or an
# unwritable `.charness/` must not block a push whose gate just passed. A first
# version guarded the write but not the rotation, and a read-only log directory
# turned a green gate into `EXIT=2` one line after printing "passed".
#
# Resolution is whole seconds: BSD `date` has no `%N`, so `%s` is the portable
# floor. The `_ms` suffix is the consumer's unit, not a precision claim. Failures
# are recorded under their own label so a run of red pushes cannot drag the
# passing median down — the consumer has no outcome filter.
#
# Installed by `npm run hooks:install`, which points core.hooksPath here.
# Bypass deliberately and visibly with `git push --no-verify` when a push must
# land without the gate (a docs-only revert, an emergency).
set -eu

# Relative on purpose: git runs a pre-push hook from the top of the working tree.
# `CEAL_TIMING_LOG` exists so a test can exercise this file for real without
# writing stub timings into the maintainer's own log.
TIMING_LOG=${CEAL_TIMING_LOG:-.charness/quality/command-timing.jsonl}
TIMING_KEEP=200

record_timing() {
	timing_label="$1"
	elapsed_ms="$2"
	# The label is interpolated into JSON, so a quote or backslash in it would
	# emit a line the consumer silently skips as malformed. Octal escapes because
	# the literal forms make shellcheck read a quoting bug that is not there.
	timing_label=$(printf '%s' "$timing_label" | tr -d '\042\134')
	mkdir -p "$(dirname "$TIMING_LOG")" || return 0
	printf '{"schema":"command_timing.v1","label":"%s","elapsed_ms":%s,"at":"%s"}\n' \
		"$timing_label" "$elapsed_ms" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$TIMING_LOG" || return 0
	# Bounded by construction: an unrotated log is its own operability problem.
	if [ "$(wc -l <"$TIMING_LOG")" -gt "$TIMING_KEEP" ]; then
		{ tail -n "$TIMING_KEEP" "$TIMING_LOG" >"$TIMING_LOG.tmp" && mv "$TIMING_LOG.tmp" "$TIMING_LOG"; } || return 0
	fi
	return 0
}

# `rc`, not `status`: AGENTS.md bans `status` as a scratch variable because it is
# tied to shell state, and a maintainer running this file under `zsh` hits
# "read-only variable: status" before the gate ever runs.
run_phase() {
	phase_label="$1"
	shift
	echo "pre-push: $phase_label — running: $*" >&2
	start=$(date +%s)
	rc=0
	"$@" || rc=$?
	elapsed=$(($(date +%s) - start))
	if [ "$rc" -eq 0 ]; then
		echo "pre-push: $phase_label passed in ${elapsed}s" >&2
		record_timing "$phase_label" "$((elapsed * 1000))"
	else
		echo "pre-push: $phase_label FAILED after ${elapsed}s (exit $rc) — rerun '$*' to see it again" >&2
		record_timing "$phase_label (failed)" "$((elapsed * 1000))"
	fi
	return "$rc"
}

tagged=0
while read -r local_ref _local_sha _remote_ref _remote_sha; do
	case "$local_ref" in
		refs/tags/*) tagged=1 ;;
	esac
done

if [ "$tagged" -eq 1 ]; then
	run_phase "tag push, full gate" npm run check
else
	run_phase "iteration gate" npm run check:unit
fi

# Maintainer-local on purpose. The duplicate ratchet needs `nose` and the charness
# quality skill, which a CI runner has neither of, so it cannot live inside
# `npm run check` without no-opping on every CI run while claiming to be part of
# the gate. Here it blocks a maintainer who introduces a new clone family, and
# says so and stands aside on a host that cannot run it.
run_phase "duplicate ratchet" node scripts/check-dup-ratchet.mjs
# Same maintainer-local shape, same reason: `npm run lint` is biome, which sees no
# shell, and the two files below are a signed release asset and this hook itself.
run_phase "shell lint" npm run lint:shell
