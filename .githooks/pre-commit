#!/bin/sh
# Commit tier (three-repo release loop S2, corca-ai/ceal#717). This clone had no
# pre-commit hook at all, so the first signal a type error gave was at pre-push,
# after the commit it belonged to had already been written.
#
# Every gate here is whole-repo rather than staged-scoped, which departs from the
# "cheap changed-file signal" docs/gates.md anticipated. The reason is measured
# on the host in hand, not assumed: `biome check .` reads the whole tree in
# ~0.45s wall and the type ratchet answers in ~1.6s, because both run on native
# engines. A staged-file selector would have to restate biome's own include set
# and tsc's project graph to save a fraction of that — more code, a second place
# for the file set to drift, and no measurable win. Time the gates before
# changing this trade; do not restore scoping on the strength of the word
# "staged".
#
# What this tier is NOT: it does not replace pre-push or CI. It runs no test and
# no build, so a commit that passes here can still fail `npm run check:unit`.
# Staying under a few seconds is what keeps it installed — a commit gate that
# costs a minute is a commit gate people pass `--no-verify`.
#
# It also reads the WORKING TREE, not the index. A partially staged file is
# judged by the version on disk, so a commit can pass here and carry content
# that never met the gate. Pre-push and CI read the committed tree and own that
# case; this tier buys feedback speed, not authority.
#
# Installed by `npm run hooks:install`, which points core.hooksPath here.
# Bypass deliberately and visibly with `git commit --no-verify`.
set -eu

# `rc`, not `status`: AGENTS.md bans `status` as a scratch variable because it is
# tied to shell state under zsh, and a maintainer hits "read-only variable" long
# before the gate runs.
run_gate() {
	gate_label="$1"
	shift
	rc=0
	"$@" || rc=$?
	if [ "$rc" -ne 0 ]; then
		echo "pre-commit: COMMIT BLOCKED by $gate_label (exit $rc) — read the output above and rerun '$*'; do not retry blind." >&2
		exit "$rc"
	fi
}

run_gate "biome" npm run lint
run_gate "type ratchet" npm run lint:types
run_gate "legacy .mjs ratchet" npm run lint:no-legacy-mjs
run_gate "gate contract" node test/gate-contract-lib.ts
run_gate "shell lint" npm run lint:shell

# Added 2026-08-18 on the measurement this file asks for, not on the argument
# that they "feel cheap". Timed on this host with a warm tree: unused 1.2s,
# reachability 1.0s, store-lock 0.9s, duplicate-literal 0.8s — 3.9s against a
# prior tier of ~2.8s.
#
# They earn it by what they catch and WHEN. Merging the paused quality lane put a
# dead export and a test file outside every lane directory into the tree; both are
# answerable from source alone, both sat silent through five commits, and both
# surfaced only when `npm run check` reached them at push — after the commits they
# belonged to were already written. That is the rework this tier exists to stop.
#
# All four read source only: knip's entry/project globs in knip.json name src,
# scripts, and test; the other three never open dist (checked, not assumed — the
# one "dist" match in check-duplicate-literal.ts is the word "distinct"). So they
# hold the tier's no-build promise. Re-time them before adding a fifth.
run_gate "unused exports" npm run lint:unused
run_gate "production reachability" npm run lint:reachability
run_gate "store lock census" npm run lint:store-lock
run_gate "duplicate literal" npm run lint:duplicate-literal
