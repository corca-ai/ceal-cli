{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-openai"
    },
    {
      "id": "@secretlint/secretlint-rule-slack"
    },
    {
      "id": "@secretlint/secretlint-rule-aws"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "private-key-pem",
            "pattern": "/-----BEGIN [A-Z ]*PRIVATE KEY-----/",
            "filePathGlobs": ["**/*", "!**/test/**", "!**/*.test.*"]
          },
          {
            "name": "github-token",
            "pattern": "/\\b(?:github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9_]{20,})\\b/"
          },
          {
            "name": "notion-internal-integration-token",
            "pattern": "/\\bntn_[A-Za-z0-9]{30,}\\b/"
          },
          {
            "name": "anthropic-token",
            "pattern": "/\\bsk-ant-[A-Za-z0-9_-]{20,}\\b/"
          },
          {
            "name": "json-client-secret-field",
            "pattern": "/client_?secret\\\\?[\"']?\\s*[:=]\\s*\\\\?[\"'][^\"'\\\\]{8,}/i",
            "filePathGlobs": ["**/*", "!**/test/**", "!**/*.test.*"]
          }
        ]
      }
    }
  ]
}
