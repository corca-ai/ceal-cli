{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": ["scripts/*.ts", "test/**/*.test.ts"],
			"project": ["scripts/**/*.ts", "test/**/*.ts"]
		},
		"packages/ceal-client": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts"]
		},
		"packages/ceal-worker-cli": {
			"entry": ["src/index.ts", "src/bin.ts", "src/acceptance-receipt.ts"],
			"project": ["src/**/*.ts"]
		}
	},
	"tags": ["-testOnly"],
	"ignoreDependencies": [
		"@secretlint/secretlint-rule-aws",
		"@secretlint/secretlint-rule-openai",
		"@secretlint/secretlint-rule-pattern",
		"@secretlint/secretlint-rule-slack",
		"postject",
		"secretlint"
	],
	"ignoreBinaries": ["nose", "shellcheck", "mkfifo", "cosign", "openssl", "awiki"]
}
