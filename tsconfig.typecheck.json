{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": true,
		"incremental": true,
		"tsBuildInfoFile": "./node_modules/.cache/ceal-typecheck.tsbuildinfo",
		"baseUrl": ".",
		"paths": {
			"@corca-ai/ceal-protocol": ["packages/ceal-protocol/src/index.ts"],
			"@corca-ai/ceal": ["packages/ceal-client/src/index.ts"]
		}
	},
	"include": ["packages/*/src/**/*.ts"],
	"exclude": ["dist", "node_modules", "packages/*/test"]
}
