{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"erasableSyntaxOnly": true,
		"types": ["node"],
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"@corca-ai/ceal-protocol": ["./packages/ceal-protocol/src/index.ts"],
			"@corca-ai/ceal": ["./packages/ceal-client/src/index.ts"]
		},
		"noEmit": true,
		"incremental": true,
		"tsBuildInfoFile": "./node_modules/.cache/ceal-tools-typecheck.tsbuildinfo"
	},
	"include": ["scripts/**/*.ts", "test/**/*.ts", "types/**/*.d.ts"],
	"exclude": ["dist", "node_modules"]
}
